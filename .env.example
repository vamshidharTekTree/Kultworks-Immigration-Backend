# ── Server ────────────────────────────────────────────────────────────────────
PORT=5100
NODE_ENV=local                              # local | staging | production

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/immigration

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=                                 # copy from master backend — used to verify staff JWTs
PORTAL_TOKEN_SECRET=                        # random 32-byte secret for beneficiary portal JWTs
S2S_SECRET=                                 # copy from master backend — for sync endpoint auth

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── AWS S3 (document storage) ─────────────────────────────────────────────────
AWS_BUCKET_NAME=                            # e.g. kultworks-immigration-documents
AWS_REGION=us-east-1                        # bucket region
AWS_SSO_PROFILE=                            # SSO profile name — run: aws configure sso

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                              # error | warn | info | debug

# ── Master Backend ────────────────────────────────────────────────────────────
MASTER_BACKEND_URL=http://localhost:5000
