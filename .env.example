PORT=5060
NODE_ENV=local          # local | staging | production
MONGO_URI=              # mongodb+srv://user:pass@cluster/immigration
JWT_SECRET=             # copy from master backend — verify only, never generate here
PORTAL_TOKEN_SECRET=    # random 32-byte secret for beneficiary portal JWTs
S2S_SECRET=             # copy from master backend — for sync endpoint auth
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
LOG_LEVEL=info
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
